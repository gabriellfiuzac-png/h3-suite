{
  "H3MG:vda_model": {
    "inputs": {
      "model": "video_depth_anything_vits.pth"
    },
    "class_type": "LoadVideoDepthAnythingModel",
    "_meta": { "title": "LoadVideoDepthAnythingModel (widget key unverified — confirm once ComfyUI-Video-Depth-Anything is installed)" }
  },
  "H3MG:load": {
    "inputs": {
      "video": "",
      "force_rate": 24,
      "custom_width": 0,
      "custom_height": 576,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    },
    "class_type": "VHS_LoadVideo",
    "_meta": { "title": "VHS_LoadVideo (source motion video)" }
  },
  "H3MG:vda_process": {
    "inputs": {
      "vda_model": ["H3MG:vda_model", 0],
      "images": ["H3MG:load", 0],
      "input_size": 518,
      "max_res": 960,
      "precision": "fp16"
    },
    "class_type": "VideoDepthAnythingProcess",
    "_meta": { "title": "VideoDepthAnythingProcess (widget keys unverified — confirm once ComfyUI-Video-Depth-Anything is installed)" }
  },
  "H3MG:vda_output": {
    "inputs": {
      "depths": ["H3MG:vda_process", 0],
      "colormap": "gray"
    },
    "class_type": "VideoDepthAnythingOutput",
    "_meta": { "title": "VideoDepthAnythingOutput (widget key unverified — confirm once ComfyUI-Video-Depth-Anything is installed)" }
  },
  "H3MG:dwpose": {
    "inputs": {
      "image": ["H3MG:load", 0],
      "detect_hand": "disable",
      "detect_body": "enable",
      "detect_face": "disable",
      "resolution": 576,
      "bbox_detector": "yolox_l.torchscript.pt",
      "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
      "scale_stick_for_xinsr_cn": "disable"
    },
    "class_type": "DWPreprocessor",
    "_meta": { "title": "DWPreprocessor (body-only DWPose)" }
  },
  "H3MG:densepose": {
    "inputs": {
      "image": ["H3MG:load", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Viridis (MagicAnimate)",
      "resolution": 576
    },
    "class_type": "DensePosePreprocessor",
    "_meta": { "title": "DensePosePreprocessor (R50, body-surface orientation)" }
  },
  "H3MG:blend_a": {
    "inputs": {
      "image1": ["H3MG:vda_output", 0],
      "image2": ["H3MG:densepose", 0],
      "blend_factor": 0.92,
      "blend_mode": "screen"
    },
    "class_type": "ImageBlend",
    "_meta": { "title": "HYBRID A - Depth + DensePose" }
  },
  "H3MG:blend_b": {
    "inputs": {
      "image1": ["H3MG:blend_a", 0],
      "image2": ["H3MG:dwpose", 0],
      "blend_factor": 0.8,
      "blend_mode": "screen"
    },
    "class_type": "ImageBlend",
    "_meta": { "title": "HYBRID B - + DWPose joint trajectory" }
  },
  "H3MG:combine": {
    "inputs": {
      "images": ["H3MG:blend_b", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "h3-suite/motion_guide/h3_motion",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p10le",
      "crf": 12,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "VHS_VideoCombine (H3 Video 1 motion guide output)" }
  }
}
